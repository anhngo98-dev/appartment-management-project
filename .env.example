# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/apartment-management
DB_NAME=apartment-management

# Supabase Configuration
# Server-side values should remain private.
SUPABASE_URL=https://vzzzfdgrbzrkpvmgqbus.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
SUPABASE_JWKS_URL=https://vzzzfdgrbzrkpvmgqbus.supabase.co/auth/v1/.well-known/jwks.json

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
